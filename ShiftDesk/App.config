<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <!--
    One connection string, one place.

    Nothing in the C# code knows the server name. Data\UserStore.cs reads this
    entry at runtime through ConfigurationManager, so moving the project to a
    machine with a different SQL Server means editing the line below and
    running the program again - no recompile, no hunting through the forms.

    Only the Data Source= part should ever need changing:

        (localdb)\MSSQLLocalDB      LocalDB installed with Visual Studio  <- set below
        .                           default instance on this machine
        localhost                   the same thing, spelled differently
        .\SQLEXPRESS                SQL Server Express
        DESKTOP-ABC123\SQLEXPRESS   Express on a named machine
  -->
  <connectionStrings>
    <add name="connString"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=db_users;Integrated Security=True;Connect Timeout=30;Encrypt=False;TrustServerCertificate=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
