<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <!--
    Same connString name, same ConfigurationManager lookup, same UserStore.cs
    reading it. Only the value differs from the Windows build, and it has to:

      Integrated Security=True means "log in as the current Windows user".
      macOS has no Windows user and no LocalDB, so the Mac build points at the
      SQL Server running in Docker and authenticates with a username and
      password instead.

    Start that server with the command in the README, then leave this alone.
  -->
  <connectionStrings>
    <add name="connString"
         connectionString="Server=localhost,1433;Initial Catalog=db_users;User Id=sa;Password=ShiftDesk!Lab2026;TrustServerCertificate=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

</configuration>
